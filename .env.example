# Copy to .env.local and fill in. Never commit real values (.env* is git-ignored; only this example is tracked).

# Public URL of the site, no trailing slash. Drives canonical URLs, sitemap, schema, redirects and the CSRF origin check.
NEXT_PUBLIC_SITE_URL=https://www.btreesystems.com

# Where enquiry leads are forwarded (CRM, Zapier, Make, Google Apps Script). Must be https in production.
# With this unset the form shows an error instead of silently dropping leads.
ENQUIRY_WEBHOOK_URL=

# Cloudflare Turnstile (free CAPTCHA alternative). Set BOTH to switch it on; leave BOTH empty to keep it off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Search Console / Bing Webmaster verification tokens.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# IndexNow key (see public/<key>.txt and `npm run seo:indexnow`). Leave as generated unless you rotate it.
INDEXNOW_KEY=
